# Firebase web app values are public identifiers and are bundled into the app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Public Supabase values. Never put service_role or sb_secret keys here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# true = Supabase Edge Functions handle Monnify; false = device-local emergency mode
EXPO_PUBLIC_ENABLE_SUPABASE_BACKEND=false
EXPO_PUBLIC_EAS_PROJECT_ID=

# Never put MONNIFY_API_KEY, MONNIFY_SECRET_KEY, or other secrets here.
# Monnify secrets will be configured in Firebase Functions during Step 9.
